# AI 提供商：anthropic 或 openai_compatible
# openai_compatible 适用于 DeepSeek、OpenAI 官方及各类代理服务
AI_PROVIDER=anthropic

# API 密钥
# Anthropic 模式：填入 sk-ant-... 开头的密钥
# DeepSeek 模式：填入 sk-... 开头的密钥
AI_API_KEY=your-api-key-here

# Base URL（openai_compatible 模式下填写，anthropic 模式留空）
# DeepSeek 官方：https://api.deepseek.com
# OpenAI 官方：留空（默认 https://api.openai.com/v1）
AI_BASE_URL=

# 模型名称
# Anthropic 示例：claude-sonnet-4-6、claude-opus-4-6
# DeepSeek 示例：deepseek-chat、deepseek-reasoner
AI_MODEL=claude-sonnet-4-6
